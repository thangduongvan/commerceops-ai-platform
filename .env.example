# Used by docker-compose "app" service (network hostname "db")
DATABASE_URL=postgresql+psycopg://commerceops:commerceops@db:5432/commerceops

# If running the app directly on the host against the Dockerized Postgres,
# override with: postgresql+psycopg://commerceops:commerceops@localhost:5432/commerceops

APP_NAME=CommerceOps AI Platform
ENVIRONMENT=local

# V3 (Caching). If running directly on the host against Dockerized Redis,
# override with: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=15
# Set to "false" to bypass the cache entirely (the V3 "without cache vs
# with cache" experiment toggle) without changing any code or infra.
CACHE_ENABLED=true

# V4 (Asynchronous Processing). LocalStack doesn't validate these
# credentials, but the boto3 SDK requires something present. Leave
# SQS_ENDPOINT_URL unset in AWS -- boto3 then uses the default regional SQS
# endpoint and the ECS task role's real credentials.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT_URL=http://localstack:4566

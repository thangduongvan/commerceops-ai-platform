# V7 (Microservices): each service has its own DATABASE_URL. Values below
# match docker-compose service hostnames.

# Product service
# DATABASE_URL=postgresql+psycopg://commerceops:commerceops@product-db:5432/commerceops_product
# DATABASE_READ_URL=postgresql+psycopg://commerceops:commerceops@product-db-replica:5432/commerceops_product

# Order service (+ worker)
# DATABASE_URL=postgresql+psycopg://commerceops:commerceops@order-db:5432/commerceops_order

# Payment service
# DATABASE_URL=postgresql+psycopg://commerceops:commerceops@payment-db:5432/commerceops_payment

# Host-side overrides when running a service outside Compose:
#   Product DB : localhost:5432 / commerceops_product
#   Product replica : localhost:5433
#   Order DB   : localhost:5434 / commerceops_order
#   Payment DB : localhost:5435 / commerceops_payment

SERVICE_NAME=order
APP_NAME=CommerceOps AI Platform
ENVIRONMENT=local

READ_REPLICA_ENABLED=true
DB_POOL_RECYCLE_SECONDS=300
DB_MAX_REPLICA_LAG_SECONDS=5
DB_TRANSIENT_RETRY_ATTEMPTS=2

REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=15
CACHE_ENABLED=true

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT_URL=http://localstack:4566

# V7: Order → peer services (Compose DNS; ECS Service Connect in AWS)
PRODUCT_SERVICE_URL=http://product:8000
PAYMENT_SERVICE_URL=http://payment:8000

PAYMENT_GATEWAY_URL=http://payment-gateway:9000
PAYMENT_CONNECT_TIMEOUT_SECONDS=1.0
PAYMENT_READ_TIMEOUT_SECONDS=2.0
PAYMENT_RETRY_ATTEMPTS=4
RETRY_BASE_DELAY_SECONDS=1.0
RETRY_MULTIPLIER=2.0
RETRY_MAX_DELAY_SECONDS=8.0

CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

PAYMENT_BULKHEAD_MAX_CONCURRENCY=10
PAYMENT_BULKHEAD_ACQUIRE_TIMEOUT_SECONDS=0.5

PRODUCT_CONNECT_TIMEOUT_SECONDS=1.0
PRODUCT_READ_TIMEOUT_SECONDS=2.0
PRODUCT_RETRY_ATTEMPTS=3
PRODUCT_BULKHEAD_MAX_CONCURRENCY=20
PRODUCT_BULKHEAD_ACQUIRE_TIMEOUT_SECONDS=0.5

SQS_VISIBILITY_TIMEOUT_SECONDS=60

# Used by docker-compose "app" service (network hostname "db")
DATABASE_URL=postgresql+psycopg://commerceops:commerceops@db:5432/commerceops

# If running the app directly on the host against the Dockerized Postgres,
# override with: postgresql+psycopg://commerceops:commerceops@localhost:5432/commerceops

APP_NAME=CommerceOps AI Platform
ENVIRONMENT=local

# V3 (Caching). If running directly on the host against Dockerized Redis,
# override with: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=15
# Set to "false" to bypass the cache entirely (the V3 "without cache vs
# with cache" experiment toggle) without changing any code or infra.
CACHE_ENABLED=true

# V4 (Asynchronous Processing). LocalStack doesn't validate these
# credentials, but the boto3 SDK requires something present. Leave
# SQS_ENDPOINT_URL unset in AWS -- boto3 then uses the default regional SQS
# endpoint and the ECS task role's real credentials.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT_URL=http://localstack:4566

# V5 (Reliability). The stand-in payment gateway (fake_gateway/) is a separate
# Compose service locally and an ECS sidecar in AWS, where this becomes
# http://localhost:9000 -- the only value that differs between the two.
PAYMENT_GATEWAY_URL=http://payment-gateway:9000

# Timeouts on the gateway call. Split because they mean different things: a
# connect timeout means nothing is listening (safe to retry), a read timeout
# means it took the request and went quiet (the charge may have happened --
# see PAYMENT_PENDING in docs/api.md).
PAYMENT_CONNECT_TIMEOUT_SECONDS=1.0
PAYMENT_READ_TIMEOUT_SECONDS=2.0

# 4 attempts with base 1.0 and multiplier 2.0 is the 1s / 2s / 4s ladder,
# each delay fully jittered (app/core/reliability.py).
PAYMENT_RETRY_ATTEMPTS=4
RETRY_BASE_DELAY_SECONDS=1.0
RETRY_MULTIPLIER=2.0
RETRY_MAX_DELAY_SECONDS=8.0

# Open the breaker after 5 consecutive failures, probe again after 30s.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# Cap concurrent gateway calls so a hanging gateway can't consume FastAPI's
# whole thread pool and take unrelated endpoints down with it.
PAYMENT_BULKHEAD_MAX_CONCURRENCY=10
PAYMENT_BULKHEAD_ACQUIRE_TIMEOUT_SECONDS=0.5

# Raised from V4's 30s: the worker's in-process retry budget has to fit
# inside the visibility window, or the message is redelivered to a second
# worker while the first is still retrying it.
SQS_VISIBILITY_TIMEOUT_SECONDS=60

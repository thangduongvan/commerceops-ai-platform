# Copy to terraform.tfvars and adjust as needed.
# Every value below has a working default in variables.tf — override only what you need to change.

region       = "us-east-1"
project_name = "commerceops"
environment  = "dev"

azs                  = ["us-east-1a", "us-east-1b"]
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.0.0/24", "10.0.1.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]

container_port      = 8000
db_port             = 5432
db_name             = "commerceops"
db_username         = "commerceops"
rds_instance_class  = "db.t3.micro"

ecs_cpu           = 256
ecs_memory        = 512
ecs_desired_count = 2

# V2 — Horizontal Scaling: Auto Scaling target-tracking policies. max_capacity
# is bounded by the RDS connection budget as much as by cost — see ADR-003.
ecs_min_capacity                = 2
ecs_max_capacity                = 8
ecs_cpu_target_value            = 60
ecs_memory_target_value         = 70
ecs_request_count_target_value  = 300

# V3 — Caching: ElastiCache Redis in front of product reads. cache_enabled
# toggles the "without cache vs with cache" experiment without touching
# infra — see ADR-004.
redis_node_type   = "cache.t3.micro"
cache_ttl_seconds = 15
cache_enabled     = true

# V4 — Asynchronous Processing: order-events SQS queue + DLQ, and the worker
# ECS service that consumes it. Auto Scaling for the worker (queue-depth
# step scaling, not CPU/memory) lives in infra/modules/autoscaling — see
# ADR-005.
sqs_visibility_timeout_seconds = 30
sqs_max_receive_count          = 5
worker_desired_count           = 1
worker_min_capacity            = 1
worker_max_capacity            = 10

# Must match the repo hosting this code, or the GitHub Actions OIDC trust policy
# will reject the workflow's token.
github_repo   = "thangduongvan/commerceops-ai-platform"
github_branch = "main"

# Optional: get an email when a CloudWatch alarm fires.
alarm_email = ""
